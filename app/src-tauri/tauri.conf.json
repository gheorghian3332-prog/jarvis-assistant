{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "J.A.R.V.I.S.",
  "version": "0.2.0",
  "identifier": "app.jarvis.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Local voice assistant",
    "publisher": "J.A.R.V.I.S. Assistant contributors",
    "copyright": "Copyright 2026 J.A.R.V.I.S. Assistant contributors",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/uv.exe": "uv.exe",
      "resources/libvosk.dll": "libvosk.dll",
      "resources/libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "resources/libstdc++-6.dll": "libstdc++-6.dll",
      "resources/libwinpthread-1.dll": "libwinpthread-1.dll",
      "resources/workers/": "resources/workers/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "J.A.R.V.I.S.",
        "installerHooks": "windows/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
