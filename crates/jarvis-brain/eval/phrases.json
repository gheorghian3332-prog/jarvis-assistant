    {"id": 3, "text": "выключи звук", "lang": "ru", "expect": {"kind": "action", "route": "fast", "action": "audio.mute"}},
    {"id": 4, "text": "open notepad", "lang": "en", "expect": {"kind": "action", "route": "fast", "action": "app.open", "arg_contains": {"query": "notepad"}}},
    {"id": 5, "text": "какая сегодня дата", "lang": "ru", "expect": {"kind": "action", "route": "fast", "action": "info.date"}},
    {"id": 6, "text": "next track", "lang": "en", "expect": {"kind": "action", "route": "fast", "action": "audio.media", "args": {"key": "next"}}},
    {"id": 7, "text": "покажи процессы", "lang": "ru", "expect": {"kind": "action", "route": "fast", "action": "process.list"}},
    {"id": 8, "text": "check the internet", "lang": "en", "expect": {"kind": "action", "route": "fast", "action": "network.check"}},
    {"id": 9, "text": "слишком оглушительно, сделай мягче", "lang": "ru", "expect": {"kind": "action", "route": "llm", "action": "audio.change_volume", "args_check": {"delta": "<0"}}},
    {"id": 10, "text": "I can barely hear anything, crank it up", "lang": "en", "expect": {"kind": "action", "route": "llm", "action": "audio.change_volume", "args_check": {"delta": ">0"}}},
    {"id": 11, "text": "make the sound level exactly half of the maximum", "lang": "ru", "expect": {"kind": "action", "route": "llm", "action": "audio.set_volume", "args": {"level": 50}}},
    {"id": 12, "text": "что у меня сейчас в папке с загрузками?", "lang": "ru", "expect": {"kind": "action", "route": "llm", "action": "files.list", "args": {"name": "downloads"}}},
    {"id": 13, "text": "всё, я пошёл спать, обесточь машину", "lang": "ru", "expect": {"kind": "action", "route": "llm", "action": "power.shutdown"}},
    {"id": 14, "text": "I am going to lunch, lock the machine", "lang": "en", "expect": {"kind": "action", "route": "llm", "action": "power.lock"}},
    {"id": 15, "text": "кто сейчас больше всего ест оперативную память?", "lang": "ru", "expect": {"kind": "action", "route": "llm", "action": "process.list", "args": {"sort": "ram"}}},
    {"id": 16, "text": "есть ли у меня сейчас связь с интернетом?", "lang": "ru", "expect": {"kind": "action", "route": "llm", "action": "network.check"}},
    {"id": 17, "text": "I need to crunch some numbers, get me a calculator", "lang": "en", "expect": {"kind": "action", "route": "llm", "action": "app.open", "arg_contains": {"query": "calc"}}},
    {"id": 18, "text": "в комнате должна быть абсолютная тишина", "lang": "ru", "expect": {"kind": "action", "route": "llm", "action": "audio.mute"}},
    {"id": 19, "text": "show me the folder where my pictures live", "lang": "en", "expect": {"kind": "action", "route": "llm", "action": "files.open_folder", "args": {"name": "pictures"}}},
    {"id": 20, "text": "убери всё с экрана, хочу видеть рабочий стол", "lang": "ru", "expect": {"kind": "action", "route": "llm", "action": "window.minimize_all"}},
    {"id": 21, "text": "эта песня надоела, давай другую", "lang": "ru", "expect": {"kind": "action", "route": "llm", "action": "audio.media", "args": {"key": "next"}}},
    {"id": 22, "text": "запомни, что я люблю джаз по вечерам", "lang": "ru", "expect": {"kind": "action", "route": "memory", "action": "memory.remember"}},
    {"id": 23, "text": "привет, как дела?", "lang": "ru", "expect": {"kind": "reply"}},
    {"id": 24, "text": "расскажи короткую шутку про программистов", "lang": "ru", "expect": {"kind": "reply"}},
    {"id": 25, "text": "what is the capital of France?", "lang": "en", "expect": {"kind": "reply", "contains_any": ["paris"]}},
    {"id": 26, "text": "спасибо, ты молодец", "lang": "ru", "expect": {"kind": "reply"}},
    {"id": 27, "text": "объясни, что значит ошибка 0x80070005", "lang": "ru", "expect": {"kind": "reply", "contains_any": ["доступ", "access", "разрешен", "прав"]}},
    {"id": 28, "text": "my program says the DLL was not found, what does that mean?", "lang": "en", "expect": {"kind": "reply", "contains_any": ["dll", "library", "missing", "not found"]}},
    {"id": 29, "text": "что такое оперативная память, в двух словах?", "lang": "ru", "expect": {"kind": "reply", "contains_any": ["памят", "данн", "запомин"]}},
    {"id": 30, "text": "где лежит мой проект?", "lang": "ru", "expect": {"kind": "reply", "contains_any": ["jarvis"]}}
